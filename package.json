{
    "name": "-",
    "version": "0.0.0",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest",
        "test": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "build": "rimraf lib && tsc",
        "reg": "npm set registry http://npm.lumigame.com",
        "run:dev": "ts-node ./src/app.ts",
        "run:container": "node --es-module-specifier-resolution=node app.js",
        "run:healthcheck": "node --es-module-specifier-resolution=node healthcheck.js",
        "pruner": "mod-pruner prune --force"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/jest": "^29.0.0",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "eslint": "^8.0.0",
        "eslint-config-google": "^0.14.0",
        "eslint-config-prettier": "^8.0.0",
        "eslint-plugin-security": "^1.0.0",
        "jest": "^29.0.0",
        "jest-extended": "^3.0.0",
        "jest-html-reporters": "^3.0.0",
        "jest-junit": "^16.0.0",
        "jest-sonar-reporter": "^2.0.0",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.0.0",
        "ts-node": "^10.0.0",
        "typescript": "^5.0.0"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    }
}
